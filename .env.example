# Optional: upload each generated deck to Google Drive as a Google Slides file.
# Copy this file to `.env` (git-ignored) and fill it in. With no `.env`, or an
# empty DRIVE_FOLDER, nothing is uploaded. See README "Google Drive upload".

# The Drive folder the decks should land in: paste the folder's link (or its ID).
DRIVE_FOLDER=https://drive.google.com/drive/folders/PASTE-FOLDER-ID-HERE

# Kill switch: `off` keeps everything configured but skips the upload.
#DRIVE_UPLOAD=off

# Sign-in: an OAuth "Desktop app" client from the Google Cloud console -- either
# paste its ID + secret here, or point DRIVE_CLIENT_FILE at the downloaded JSON.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
#DRIVE_CLIENT_FILE=.google/credentials.json

# Where the signed-in token is cached after the one-time browser consent.
# Relative paths are relative to this file.
#DRIVE_TOKEN_FILE=.google/token.json
